# ── RPC ────────────────────────────────────────────────────────────────
# Alchemy Sepolia RPC URL
# https://dashboard.alchemy.com → Create App → Ethereum Sepolia
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ── Wallets ─────────────────────────────────────────────────────────────
# Seller: NFT 소유자 지갑 (MetaMask Export Private Key)
PRIVATE_KEY=0xyour_seller_private_key

# Buyer: NFT 구매자 지갑 (없으면 Seller와 동일 지갑으로 테스트)
BUYER_PRIVATE_KEY=0xyour_buyer_private_key

# ── NFT ─────────────────────────────────────────────────────────────────
# `npm run deploy-nft` 실행 후 출력되는 값을 입력
NFT_CONTRACT_ADDRESS=0x_deployed_test_nft_address
TOKEN_ID=0

# ── Order ───────────────────────────────────────────────────────────────
# 판매 가격 (ETH 단위)
SELL_PRICE_ETH=0.001
