# ── 로컬 개발 ───────────────────────────────────────────────────────
# (1) 호스트 실행: POSTGRES_HOST=localhost, FRONTEND_URL=http://localhost:3000
# (2) docker-compose.local (nginx :80): FRONTEND_URL=http://localhost · compose가 POSTGRES_HOST=postgres 로 덮어씀
# 운영: NODE_ENV=production 에서 synchronize=false → backend/sql/migrations/ 로 스키마 반영

PORT=4000

# 브라우저 출처와 동일 (쉼표 구분). LAN에서 프론트 접속 시 예: http://192.168.x.x:3000 추가
CORS_ORIGIN=http://localhost:3000

# ── Ethereum Sepolia ──────────────────────────────────────────────
# Alchemy: https://dashboard.alchemy.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Sepolia USDC (Circle 공식 — 변경 불필요)
USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Tokenable_RWA (ERC-721) — Sepolia 배포 후 주소
# 배포: cd contracts && pnpm exec hardhat run scripts/deploy-tokenable-rwa-sepolia.ts --network sepolia
NFT_CONTRACT_ADDRESS=0x_your_tokenable_rwa_sepolia_address

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tokenable
POSTGRES_PASSWORD=tokenable
POSTGRES_DB=tokenable

# ── Pinata (IPFS) — 업로드용 JWT + SDK용 게이트웨이 호스트 ─────────
# 프론트 이미지 조회는 NEXT_PUBLIC_PINATA_GATEWAY (프론트 .env)와 호스트 맞출 것
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=your-subdomain.mypinata.cloud

# ── JustTCG ───────────────────────────────────────────────────────
TCG_API_KEY=your_tcg_api_key

# ── PSA Public API (optional) ───────────────────────────────────
# https://www.psacard.com/publicapi — 한 줄로 붙여넣기 (백엔드가 공백 제거)
# PSA_PUBLIC_API_TOKEN=
# PSA_PUBLIC_API_MAX_RETRIES=2
# PSA_PUBLIC_API_CACHE_TTL_MS=600000

# ── Auth (Google OAuth + JWT) ───────────────────────────────────
# Google 콘솔 「승인된 리디렉션 URI」= GOOGLE_CALLBACK_URL 과 완전히 동일
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_SEC=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# 선택: JWT 쿠키 Secure. 미설정 시 FRONTEND_URL 이 https 일 때만 true
# COOKIE_SECURE=false

# ── 이메일 (플랫폼 인증 메일) — 미설정 시 링크는 서버 로그만(SMTP 미발송)
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false + 앱 비밀번호
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@localhost
