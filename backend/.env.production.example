# ── 개발 서버 (EC2 + docker-compose) 예시 ─────────────────────────
# 실제 값은 서버의 /home/ubuntu/.env.production.backend 등에만 두고 커밋하지 말 것.
# 현재 프론트 접속: http://54.116.29.201/  (nginx :80 → / , /api → 백엔드)
#
# Google OAuth: 「JavaScript 출처」에 순수 IP(http://54.116.29.201) 가 거부되면
#   nip.io 예: http://54-116-29-201.nip.io (브라우저·콘솔 URI 모두 이 호스트로 통일)
#
# 첫 DB: TypeORM synchronize=false → backend/sql/migrations/ 실행
#   001_add_platform_email_verification.sql, 002_orders_updated_at.sql
PORT=4000
NODE_ENV=production

FRONTEND_URL=http://54.116.29.201
CORS_ORIGIN=http://54.116.29.201

# ── Ethereum Sepolia ─────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NFT_CONTRACT_ADDRESS=0x_your_tokenable_rwa_sepolia_address

# ── PostgreSQL (docker-compose 서비스명) ───────────────────────────
POSTGRES_HOST=tokenable-postgres
POSTGRES_PORT=5432
POSTGRES_USER=tokenable
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=tokenable

# ── Pinata (IPFS) ────────────────────────────────────────────────
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=your-gateway.mypinata.cloud

# ── JustTCG ─────────────────────────────────────────────────────
TCG_API_KEY=your_tcg_api_key_here

# ── PSA Public API (optional) ───────────────────────────────────
# PSA_PUBLIC_API_TOKEN=
# PSA_PUBLIC_API_MAX_RETRIES=2
# PSA_PUBLIC_API_CACHE_TTL_MS=600000

# ── Auth (Google OAuth + JWT) ───────────────────────────────────
# 승인된 리디렉션 URI = 아래와 동일 (끝의 / 없이)
JWT_SECRET=change_me_production_random
JWT_EXPIRES_SEC=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://54.116.29.201/api/auth/google/callback

# HTTP 배포. https 쓰면 FRONTEND_URL 맞추고 필요 시 true
# COOKIE_SECURE=false

# ── 이메일 (optional) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
