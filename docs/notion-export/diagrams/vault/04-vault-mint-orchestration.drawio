<mxfile host="app.diagrams.net" agent="tokenable-vault-docs" version="22.1.0">
  <diagram id="vault-mint" name="Mint Orchestration">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Platform-Owned Mint Orchestration" style="text;html=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="15" width="400" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="trigger" value="custody_verified&#xa;(item state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="queue" value="vault_mint_jobs&#xa;status: queued&#xa;wallet = default_wallet&#xa;or submission override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="Mint Worker (BullMQ)&#xa;idempotent by item_id&#xa;attempt_count · backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="relayer" value="Platform Relayer&#xa;MINTER_ROLE wallet&#xa;(NOT user browser mint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="chain" value="On-chain mint tx&#xa;tokenId · tx_hash" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="1000" y="95" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="trigger" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="queue" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="1" source="worker" target="relayer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="relayer" target="chain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="confirm" value="Tx watcher / receipt&#xa;mint_confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="760" y="220" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="registry" value="asset_cert_registry&#xa;INSERT active&#xa;(grader, cert_number) UNIQUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="220" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="rwa" value="rwa_tokens row&#xa;link token_id · listing ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="280" y="220" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="item.status = completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#fff;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="chain" target="confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="confirm" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;" edge="1" parent="1" source="registry" target="rwa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=classic;html=1;" edge="1" parent="1" source="rwa" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sla" value="SLA POLICY (agreed)&#xa;• Auto-enqueue within minutes of custody_verified&#xa;• Max dwell custody_verified: 24h → auto mint&#xa;• 7d without resolution → escalate / exception state&#xa;• No steady-state limbo at custody_verified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="420" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="fail" value="mint_failed → retry queue&#xa;max attempts → manual ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="540" y="330" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="open" value="OPEN (critical): Mint before NFT V2 contract?&#xa;  A) Interim relayer on current contract&#xa;  B) Wait for NFT V2 with certKey + MINTER_ROLE&#xa;OPEN: Mint to default_wallet vs user-select per item?&#xa;OPEN: Gas sponsorship model (platform pays all)?&#xa;OPEN: certKey on-chain in V2 — format and who generates?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="430" width="700" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
