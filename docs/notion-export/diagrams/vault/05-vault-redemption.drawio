<mxfile host="app.diagrams.net" agent="tokenable-vault-docs" version="22.1.0">
  <diagram id="vault-redeem" name="Redemption Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Redemption: Burn → Release → Outbound Ship" style="text;html=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="15" width="450" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="Token Holder" style="shape=umlActor;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1. Request redemption&#xa;RDM-{YYYY}-{SEQ}&#xa;shipping address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="150" y="110" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="check" value="Pre-checks&#xa;□ Owner of token&#xa;□ NOT listed (delist first)&#xa;□ Item status = completed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="150" y="200" width="170" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2. Admin approve&#xa;inventory → redemption_reserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3. Burn NFT&#xa;user or platform tx&#xa;burn_tx_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4. cert_registry&#xa;status → released&#xa;custody_exit_record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5. Physical pick + exit evidence&#xa;slab photos at ship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="6. Outbound FedEx&#xa;vault_outbound_shipments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="7. redeemed&#xa;item terminal state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="150" y="320" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="revault" value="Re-vault path&#xa;New TBV submission&#xa;cert eligible (released)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;dashed=1;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="s1" target="check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="check" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="optional" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="s7" target="revault"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="open" value="OPEN: Burn timing — approve → burn → pick, or pick → burn?&#xa;OPEN: Who signs burn tx — holder wallet vs platform relayer?&#xa;OPEN: Redemption fee structure and who pays outbound shipping?&#xa;OPEN: Cooldown period after purchase before redemption allowed?&#xa;OPEN: Partial redemption in multi-item submission (post-MVP)?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="420" width="720" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="agreed" value="AGREED: Must delist before redemption (409 if active listing)&#xa;AGREED: cert_registry released on burn — enables re-vault same cert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="510" width="520" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
