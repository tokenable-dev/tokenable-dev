<mxfile host="app.diagrams.net" agent="tokenable-vault-docs" version="22.1.0">
  <diagram id="vault-intake" name="Intake and Evidence">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Vault Intake Session &amp; Custody Evidence Flow" style="text;html=1;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="15" width="450" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="admin" value="Vault Admin&#xa;(supervisor lock)" style="shape=umlActor;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="40" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step1" value="1. Package arrives&#xa;delivered_to_vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="160" y="100" width="160" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="2. Open intake session&#xa;INT-{TBV-ID}&#xa;packaging_condition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="360" y="95" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="3. Per item: scan cert&#xa;PSA API validate (optional MVP)&#xa;match submission_items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="580" y="95" width="200" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="step4" value="4. Capture evidence bundle&#xa;slab_front · slab_back · label&#xa;packaging photos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="820" y="95" width="200" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="storage" value="Private Object Storage (S3 / R2)&#xa;NOT IPFS · NOT public CDN&#xa;sha256 per file · signed URLs for admin" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="220" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="5. Custody verify&#xa;custody_records row&#xa;verified_by · cert_match=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="220" width="200" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="step6" value="6. Lock session&#xa;intake_complete&#xa;item → custody_verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#fff;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="GATES (all required)&#xa;□ Evidence bundle complete&#xa;□ Cert matches declared&#xa;□ No duplicate active cert in registry&#xa;□ Supervisor session lock held" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="160" y="220" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="step4" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="gate" target="step5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fedex" value="FedEx Track API (poll)&#xa;in_transit → delivered_to_vault&#xa;MVP: manual status override allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="160" y="360" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="v2" value="V2: dual verifier (four-eyes)&#xa;Enterprise: four-eyes on all custody ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;dashed=1;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="360" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="open" value="OPEN: PSA cert API — block intake if API down or warn + manual override?&#xa;OPEN: OCR auto-fill cert from slab photo — V2 scope?&#xa;OPEN: Evidence retention policy (years) and legal hold process?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="450" width="700" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
