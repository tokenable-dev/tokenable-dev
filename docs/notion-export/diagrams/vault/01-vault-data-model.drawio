        <mxCell id="sub" value="vault_submissions&#xa;PK id · UNIQUE submission_id TBV-YYYY-SEQ&#xa;user_id · status · default_wallet&#xa;FedEx tracking (denorm)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;align=left;spacingLeft=8;startSize=26;" vertex="1" parent="1">
