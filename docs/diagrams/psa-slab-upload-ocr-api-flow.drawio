<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-03-30T00:00:00.000Z" agent="Tokenable" version="24.7.7" type="device" compressed="false">
  <diagram id="psa-flow-1" name="PSA 슬랩 업로드·OCR·API 흐름">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="PSA 슬랩 — 이미지 업로드 → OCR → 외부 API (단일 페이지 요약)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="코드 기준: frontend `MintForm` / `analyzePsaSlab` · backend `PsaController` → `PsaService` · `PriceService` · `PsaPublicApiService`" style="text;html=1;fontSize=11;fontStyle=2;align=left;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1840" height="28" as="geometry" />
        </mxCell>

        <!-- Swimlane: Client -->
        <mxCell id="lane_c" value="① 브라우저 (Next.js) — 슬랩 이미지 선택" style="swimlane;horizontal=1;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1840" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="필수: 슬랩 앞면 이미지 (`verification.slabFront` → File)&#xa;선택: 슬랩 뒷면, Certification URL (선택 시 OCR보다 우선으로 Cert 숫자 추출)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_c">
          <mxGeometry x="48" y="48" width="520" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="자동 분석 트리거: 슬랩 앞면이 File이면 디바운스 후 `analyzePsaSlab(front, back, certHint)` 호출&#xa;수동: &quot;Analyze&quot; 등에서 동일 함수" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_c">
          <mxGeometry x="600" y="48" width="560" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="HTTP: `POST {API}/psa/analyze`&#xa;• `multipart/form-data` 필드: `slabFront`(필수), `slabBack`(선택), `certNumber`(선택 — 숫자 또는 psacard.com/cert/… URL)&#xa;• 프론트는 `credentials: include` (쿠키)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#e1d5e7;fontStyle=1;" vertex="1" parent="lane_c">
          <mxGeometry x="48" y="132" width="1112" height="56" as="geometry" />
        </mxCell>

        <!-- Swimlane: Backend entry -->
        <mxCell id="lane_b0" value="② 백엔드 진입 (NestJS)" style="swimlane;horizontal=1;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1840" height="88" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="`PsaController.analyze` — Multer `FileFieldsInterceptor` (slabFront, slabBack), 이미지만 JPEG/PNG/WebP, 파일당 최대 15MB&#xa;→ `PsaService.analyzeSlabImages(frontBuffer, backBuffer?, certHint?)`" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_b0">
          <mxGeometry x="48" y="48" width="1740" height="32" as="geometry" />
        </mxCell>

        <!-- Swimlane: OCR -->
        <mxCell id="lane_ocr" value="③ 서버 내 OCR·전처리 (라이브러리만 — 외부 OCR API 없음)" style="swimlane;horizontal=1;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="428" width="1840" height="260" as="geometry" />
        </mxCell>
        <mxCell id="ocr1" value="sharp&#xa;• 앞(·뒤) 버퍼: 리사이즈(최대 2200px), 그레이스케일, normalize → PNG" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_ocr">
          <mxGeometry x="48" y="48" width="280" height="88" as="geometry" />
        </mxCell>
        <mxCell id="ocr2" value="tesseract.js (eng)&#xa;• 전면·후면 각각 `PSM.AUTO` 로 전체 OCR&#xa;• 보조: 상단 라벨 스트립 크롭 → `PSM.SINGLE_BLOCK`&#xa;• 보조: Cert 숫자 구역 → 숫자 whitelist OCR" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_ocr">
          <mxGeometry x="360" y="48" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ocr3" value="텍스트 합본&#xa;front + back + labelStrip + certDigits&#xa;(너무 길면 앞 150,000자로 자름)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#f8cecc;" vertex="1" parent="lane_ocr">
          <mxGeometry x="752" y="48" width="280" height="88" as="geometry" />
        </mxCell>
        <mxCell id="ocr4" value="`parsePsaLabelFromOcr` (로컬 파싱)&#xa;→ Cert 번호·등급·연도 등 `ParsedPsaLabel`&#xa;폼 `certNumber` 힌트가 있으면 OCR 결과에 병합(우선)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_ocr">
          <mxGeometry x="48" y="176" width="520" height="72" as="geometry" />
        </mxCell>
        <mxCell id="e_ocr12" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="lane_ocr" source="ocr1" target="ocr2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ocr23" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="lane_ocr" source="ocr2" target="ocr3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Swimlane: External PSA -->
        <mxCell id="lane_ext" value="④ 외부 API — PSA Public API (병렬) + 이미지 검증" style="swimlane;horizontal=1;startSize=32;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="708" width="1840" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ext_psa1" value="환경변수 `PSA_PUBLIC_API_TOKEN` 없음 → 두 호출 모두 `disabled/skipped` (분석은 계속)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#fff9e6;dashed=1;" vertex="1" parent="lane_ext">
          <mxGeometry x="48" y="48" width="1740" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ext_psa2" value="GET&#xa;`https://api.psacard.com/publicapi/cert/GetByCertNumber/{cert}`&#xa;Header: `Authorization: bearer {token}`&#xa;→ PSACert 등 공식 메타 (`mergePsaApiIntoParsed`)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_ext">
          <mxGeometry x="48" y="96" width="420" height="88" as="geometry" />
        </mxCell>
        <mxCell id="ext_psa3" value="GET (동시에 `Promise.all`)&#xa;`https://api.psacard.com/publicapi/cert/GetImagesByCertNumber/{cert}`&#xa;→ 슬랩 사진 URL 목록 파싱" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_ext">
          <mxGeometry x="500" y="96" width="460" height="88" as="geometry" />
        </mxCell>
        <mxCell id="ext_psa4" value="Cert ≥ 7자리일 때: 응답에서 앞·뒤 이미지 URL 추출 후&#xa;앞면 URL에 대해 `HEAD` 또는 `GET Range`로 도달 가능 여부 probe (실패해도 URL은 사용 가능)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#e1d5e7;" vertex="1" parent="lane_ext">
          <mxGeometry x="992" y="96" width="796" height="88" as="geometry" />
        </mxCell>

        <!-- Swimlane: Cardhedger -->
        <mxCell id="lane_jt" value="⑤ 외부 API — Cardhedger (카드 검색/가격)" style="swimlane;horizontal=1;startSize=32;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="928" width="1840" height="120" as="geometry" />
        </mxCell>
        <mxCell id="jt1" value="`buildJustTcgSearchQueryAfterMerge` 로 검색어 문자열 생성 (PSA 병합 결과·OCR 텍스트 기반)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_jt">
          <mxGeometry x="48" y="48" width="560" height="56" as="geometry" />
        </mxCell>
        <mxCell id="jt2" value="`CardhedgerService` → POST&#xa;`https://api.cardhedger.com/v1/cards/card-match` (or search/pricing APIs)&#xa;인증: `CARDHEDGER_API_KEY`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="lane_jt">
          <mxGeometry x="640" y="40" width="640" height="72" as="geometry" />
        </mxCell>
        <mxCell id="e_jt" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="lane_jt" source="jt1" target="jt2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Response -->
        <mxCell id="lane_res" value="⑥ 응답 JSON (`PsaAnalyzeResult`) — 프론트가 필드 자동 채움·민팅 이미지 후보로 사용" style="swimlane;horizontal=1;startSize=32;fillColor=#e6d0de;strokeColor=#996185;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1068" width="1840" height="100" as="geometry" />
        </mxCell>
        <mxCell id="res1" value="`ocr`: combinedText, frontText, backText, labelStripText, certDigitsText&#xa;`psa`: 파싱·API 병합 필드, certVerifyUrl, enrichedFromOfficialApi&#xa;`psaApi.lookup`, `cardhedger` (cardId, searchQuery, imageUrl), `psaCertImages` { front, back }?" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_res">
          <mxGeometry x="48" y="48" width="1740" height="44" as="geometry" />
        </mxCell>

        <!-- Mint upload separate -->
        <mxCell id="lane_mint" value="⑦ 민팅 단계 (분석 완료 후) — 별도 API" style="swimlane;horizontal=1;startSize=32;fillColor=#bac8d3;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1188" width="1840" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="사용자가 Mint 클릭 시 `POST {API}/rwa/upload` (multipart)&#xa;• 이름·설명·이미지: PSA 공식 앞면 URL(`imageUrl`)이 있으면 우선, 없으면 업로드 파일(`image`)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane_mint">
          <mxGeometry x="48" y="48" width="900" height="56" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="이후 스마트컨트랙트 민트 트랜잭션은 프론트 wagmi (`TOKENABLE_RWA` 등) — 본 다이어그램 범위 아님" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=10;fillColor=#f5f5f5;dashed=1;fontStyle=2;" vertex="1" parent="lane_mint">
          <mxGeometry x="992" y="48" width="796" height="56" as="geometry" />
        </mxCell>

        <!-- Vertical flow arrows between lanes -->
        <mxCell id="flow1" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lane_c" target="lane_b0">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="310" as="sourcePoint" />
            <mxPoint x="960" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="flow2" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lane_b0" target="lane_ocr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow3" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lane_ocr" target="lane_ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow4" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lane_ext" target="lane_jt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow5" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="lane_jt" target="lane_res">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow6" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="lane_res" target="lane_mint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg" value="범례 · 환경변수&#xa;• PSA_PUBLIC_API_TOKEN — PSA Public API&#xa;• CARDHEDGER_API_KEY — Cardhedger 실호출 시 필수&#xa;• OCR은 서버 로컬 tesseract.js; 별도 Google Vision 등 외부 OCR API 없음&#xa;• 배포 이슈: sharp/tesseract 메모리, HTTPS 아웃바운드, 업로드 본문 크기 — `docs/DEVELOPMENT.md` §6 참고" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=10;fillColor=#ffffcc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1340" width="1840" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
