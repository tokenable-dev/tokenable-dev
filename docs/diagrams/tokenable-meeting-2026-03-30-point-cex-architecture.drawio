  <diagram id="t0" name="00-INDEX">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t0_t" value="Tokenable — 방향성 아키텍처 (2026-03-30 회의)" style="text;html=1;fontSize=20;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="720" height="36" as="geometry" />
        </mxCell>
        <mxCell id="t0_b" value="회의: 기획·개발 공유, 중앙/탈중앙 논의, Point·Wallet 충전 1차 논의&#xa;결론: 개발사항 정리 + Point 시스템 기반 구조 변경&#xa;&#xa;탭 구성:&#xa;01 — 비전 &amp; 핵심 설계 요약&#xa;02 — Point 충전 (Web2 PG + Web3 USDC→Vault)&#xa;03 — Custody · 오더북 · 내부 Ledger&#xa;04 — RWA 발행 &amp; 컬렉션 단위 이중 구조&#xa;05 — PSA 입고 · 진위 검증 · NFT 발행 흐름&#xa;06 — 주식 비유 &amp; 거래·수익 모델" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=12;fillColor=#fff9e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="680" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="t1" name="01-비전-핵심설계">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a1_t" value="목표: 실물 기반 RWA NFT를 빠르게 거래하는 중앙화 거래소형 마켓플레이스" style="text;html=1;fontSize=16;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a1_sub" value="사용자는 블록체인 복잡성을 최소 인지 · 플랫폼은 안정성·속도·수익(거래 수수료) 확보" style="text;html=1;fontSize=11;fontStyle=2;align=left;fillColor=#fff9e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="800" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a1_b1" value="Point 기반 결제&#xa;· PG(카드·계좌) + 크립토(USDC→Vault)&#xa;· 입금 검증: Webhook/API · tx hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a1_b2" value="Custody NFT&#xa;· Vault Wallet 보관&#xa;· DB상 소유 = 사용자 계정&#xa;· 실제 자산은 플랫폼 수탁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a1_b3" value="RWA NFT 발행&#xa;· 실물 검수·KYC 후 컬렉션&#xa;· 실물 N장 = NFT N개 (1:1)&#xa;· ERC-721" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a1_b4" value="오더북 거래&#xa;· 컬렉션 단위 매수/매도&#xa;· 매칭 후 Point↔NFT (DB Ledger)&#xa;· 온체인은 입출금 위주" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a1_mid" value="빠른 체결: 온체인 전송 대신 내부 DB 소유권 변경 · 실시간·저수수료·높은 TPS · 온체인 이동은 입출금 시점" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#ffffcc;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="a1_fee" value="수익: 거래마다 수수료 (Upbit 유사 · 거래량 기반)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a1_ex" value="거래 흐름 예 (요약)&#xa;1) 실물 PSA 카드 확보 → 컬렉션 + NFT N개 발행&#xa;2) 초기 판매 등록 → 타 사용자 Point로 매수 주문&#xa;3) 오더북 매칭 → 즉시 체결&#xa;4) 재판매 반복 → 유동성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;align=left;spacingLeft=8;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="520" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="t2" name="02-Point충전-Web2-Web3">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b2_t" value="Point 충전 — Web2(PG) vs Web3(USDC)" style="text;html=1;fontSize=18;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="32" as="geometry" />
        </mxCell>
        <mxCell id="b2_common" value="공통: 플랫폼 접속 후 Web2 로그인/회원가입(신원) + (선택) Connect Wallet" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#fff9e6;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="b2_w2h" value="Web2 — Buy Point" style="text;html=1;fontSize=14;fontStyle=1;align=left;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="b2_w2" value="1) Buy Point 클릭&#xa;2) PG 결제(카드·계좌이체 등)&#xa;3) 서버: Webhook 또는 결제 검증 API로 승인 검증&#xa;4) 검증 완료 → 계정에 Point 적립" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2_w3h" value="Web3 — USDC → Vault" style="text;html=1;fontSize=14;fontStyle=1;align=left;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="b2_w3" value="1) Connect Wallet&#xa;2) 사용자 지갑 → 플랫폼 Vault Wallet으로 USDC 송금&#xa;3) 네트워크 수수료: 지갑에 소량 ETH(또는 해당 체인 가스)&#xa;4) 블록체인 확인 후 tx hash로 입금 검증&#xa;5) 대응 Point 계정 적립" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2_db" value="플랫폼 계정 (Ledger)&#xa;Point 잔액 · 사용자 ID와 연동" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b2_e1" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="b2_w2" target="b2_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b2_e2" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="b2_w3" target="b2_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="t3" name="03-Custody-오더북-Ledger">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3_t" value="Custody · 오더북 · 내부 Ledger" style="text;html=1;fontSize=18;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="480" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c3_user" value="사용자" style="swimlane;horizontal=0;startSize=40;fillColor=#dae8fc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="200" height="480" as="geometry" />
        </mxCell>
        <mxCell id="c3_u1" value="Point 보유&#xa;매수/매도 주문" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="c3_user">
          <mxGeometry x="20" y="60" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3_plat" value="플랫폼 (매칭 엔진 + DB)" style="swimlane;horizontal=0;startSize=40;fillColor=#ffe6cc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="70" width="520" height="480" as="geometry" />
        </mxCell>
        <mxCell id="c3_ob" value="Orderbook&#xa;컬렉션 단위 호가&#xa;매수↔매도 매칭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1" vertex="1" parent="c3_plat">
          <mxGeometry x="40" y="60" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3_led" value="내부 Ledger (DB)&#xa;Point 차감/지급&#xa;NFT 소유권 레코드" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="c3_plat">
          <mxGeometry x="280" y="60" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c3_match" value="체결 시&#xa;구매자: Point↓ NFT 소유↑&#xa;판매자: NFT↓ Point↑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="c3_plat">
          <mxGeometry x="40" y="190" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c3_vault" value="Vault Wallet&#xa;ERC-721 NFT 실물 보관(온체인)&#xa;Custody" style="swimlane;horizontal=0;startSize=36;fillColor=#fad9d5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="860" y="70" width="280" height="480" as="geometry" />
        </mxCell>
        <mxCell id="c3_v1" value="NFT는 사용자 개인 지갑이 아닌&#xa;플랫폼 Vault에서 관리&#xa;(빠른 재매칭·동일 UX)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="c3_vault">
          <mxGeometry x="20" y="50" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c3_note" value="온체인 NFT 전송 없이 DB에서 소유권만 갱신 → 실시간 체결. 출금·외부 전송 시에만 온체인 이동(정책에 따름)." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#ffffcc;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1100" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c3_e1" style="endArrow=classic;html=1;entryX=0;entryY=0.35;exitX=1;exitY=0.35;" edge="1" parent="1" source="c3_user" target="c3_plat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3_e2" style="endArrow=classic;html=1;dashed=1;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="1" source="c3_plat" target="c3_vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="t4" name="04-RWA-컬렉션-이중구조">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d4_t" value="RWA 발행 &amp; 컬렉션 단위 거래 — 사용자 vs 플랫폼 내부" style="text;html=1;fontSize=18;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="d4_issue" value="발행: 실물 검수·KYC 완료 → 컬렉션 생성 → 실물 n개 = ERC-721 NFT n개 (1:1)&#xa;동일 속성 카드는 준-대체처럼 컬렉션 내에서 호가 단위로 거래" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#fff9e6;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1000" height="48" as="geometry" />
        </mxCell>
        <mxCell id="d4_left" value="사용자가 보는 것" style="swimlane;horizontal=1;startSize=32;fillColor=#dae8fc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="480" height="280" as="geometry" />
        </mxCell>
        <mxCell id="d4_l1" value="· 컬렉션 단위 인식 (예: 해변의 피카츄 PSA 10)&#xa;· Cert Number는 거래 의사결정에 불필요&#xa;· 매수/매도 주문 = 컬렉션 기준 (주식 종목처럼)&#xa;· 수량·가격만 설정 가능 (이미지/Cert 입력 부담 ↓)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;" vertex="1" parent="d4_left">
          <mxGeometry x="20" y="50" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d4_right" value="플랫폼 내부 (반드시 관리)" style="swimlane;horizontal=1;startSize=32;fillColor=#ffe6cc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="520" height="280" as="geometry" />
        </mxCell>
        <mxCell id="d4_r1" value="· PSA Cert Number, 실물 이미지, 검수 데이터&#xa;· 입고·보관 상태&#xa;· 체결 시 내부에서 개별 RWA ↔ 소유자 매핑 (예: 매수자에게 Cert# 할당)&#xa;· 출고·감사·분쟁 대응&#xa;&#xa;👉 Cert는 UX에서 숨김, 데이터에서는 소멸하지 않음" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;fontSize=11;" vertex="1" parent="d4_right">
          <mxGeometry x="20" y="50" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="d4_why" value="1:N 개별 NFT 단위 거래를 플랫폼 전체에 허용하면: 오더북 복잡도↑ · 동일 카드 Cert 때문에 체결 실패 · UX 혼란 → 컬렉션 단위만 허용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;align=left;spacingLeft=8;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1040" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d4_ex" value="예: 컬렉션 재고 2 — 내부 RWA Cert#001, 002&#xa;사용자 A 매수 체결 → 내부적으로 001 할당 / 사용자 B → 002 할당 (사용자는 Cert 몰라도 됨)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="720" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="t5" name="05-PSA-입고-검증-흐름">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="e5_t" value="PSA 카드 입고 · 진위 검증 · 발행 (정리 흐름)" style="text;html=1;fontSize=18;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e5_n" value="전제: PSA 슬랩 카드는 통상 PSA 카드팩 포장으로 도착 — 플랫폼은 PSA API(DB)로 Cert 조회해 등급·종목 진위 검증" style="text;html=1;fontSize=11;fontStyle=2;align=left;fillColor=#fff9e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="e5_1" value="1. 카드 도착 · 플랫폼 수령" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e5_2" value="2. PSA API 조회&#xa;Cert → 등급·카드명·연도 등" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e5_3" value="3. 내부 검수·기록&#xa;(이미지·상태)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e5_4" value="4. 컬렉션 생성&#xa;+ RWA NFT 발행 (ERC-721)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="720" y="110" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e5_5" value="5. 사용자 거래&#xa;컬렉션 오더북" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
