        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg08_erdTitle" value="PostgreSQL — 로컬 스키마 (ERD 요약)" style="text;html=1;fontSize=16;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg08_sub" value="도메인: users, marketplace_collections, orders — 상세는 docs/DEVELOPMENT.md §1" style="text;html=1;fontSize=11;fontStyle=2;align=left;fillColor=#fff9e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pg08_t_users" value="users&#10;───&#10;PK  id : uuid&#10;    email : varchar(320) UNIQUE&#10;    google_id : varchar(64) UNIQUE&#10;    name, picture_url&#10;    email_verified&#10;    platform_email_verified_at&#10;    email_verification_* (토큰·만료·발송)&#10;    wallet_address : varchar(42) UNIQUE&#10;    wallet_linked_at&#10;    created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="pg08_t_mc" value="marketplace_collections&#10;───&#10;PK  collection_key : varchar(64)&#10;    display_label : text&#10;    query_used : text&#10;    components : jsonb&#10;    cover_image_url : text&#10;    created_at" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pg08_t_orders" value="orders&#10;───&#10;PK  id : serial&#10;UQ  order_hash&#10;    offerer (ask=판매자 / bid=구매자)&#10;    side : enum ask | bid&#10;    token_contract, token_id&#10;FK  bucket_bid_id → bucket_bids.id (nullable)&#10;    collection_key → marketplace_collections (논리)&#10;    consideration_token, consideration_amount&#10;    parameters : jsonb (Seaport)&#10;    signature : text&#10;    status : active|fulfilled|cancelled|expired&#10;    start_time, end_time&#10;    created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;align=left;spacingLeft=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="360" width="360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="pg08_t_bb" value="bucket_bids&#10;───&#10;PK  id : serial&#10;    bucket_key : varchar(64) INDEX&#10;    token_contract&#10;    buyer_offerer INDEX&#10;    consideration_amount (USDC min units)&#10;    components : jsonb&#10;    signature, nonce (EIP-712)&#10;    status : active|fulfilled|cancelled|expired&#10;    start_time, end_time&#10;    fulfilled_token_id&#10;    created_at, updated_at" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="pg08_e1" value="collection_key" style="endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pg08_t_mc" target="pg08_t_orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg08_e2" value="bucket_bid_id ON DELETE SET NULL" style="endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pg08_t_bb" target="pg08_t_orders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg08_note" value="users ↔ orders: 앱 레벨 FK 없음 (주문은 지갑 offerer 기준).&#10;상세: Swagger `/api/docs`, 엔티티 `backend/src/**/entities`" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;dashed=1;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="380" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg04" name="04-D-Seaport-D1~D4">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2624" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg09_t0" value="Tokenable — Seaport 사용 구조 (프로젝트 기준)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="32" as="geometry" />
        </mxCell>
        <mxCell id="pg09_t0b" value="Seaport 1.5 = ERC-721 RWA ↔ USDC 스왑 주문만. 백엔드는 주문 저장·검증; 체결 트랜잭션은 사용자 지갑. 상세: docs/DEVELOPMENT.md §3" style="text;html=1;strokeColor=none;fillColor=#fff9e6;align=left;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="920" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg09_b1" value="① 사용자 지갑&#10;· MetaMask 등&#10;· Sepolia&#10;· getCounter(offerer)&#10;· EIP-712 서명&#10;  (domain: Seaport 1.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pg09_b2" value="② 백엔드 API&#10;POST /marketplace/orders&#10;parameters + signature&#10;→ PostgreSQL 'orders'&#10;(오프체인 오더북)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pg09_b3" value="③ 마켓 UI&#10;· 활성 ask / bid 조회&#10;· 가격·토큰 표시&#10;· 리스트/상세/컬렉션" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pg09_b4" value="④ 체결 (온체인)&#10;Seaport.fulfillOrder&#10;· RWA + USDC 이동&#10;· 가스 = tx 발신 지갑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="120" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pg09_b5" value="⑤ DB 동기화&#10;PATCH .../orders/:hash/fulfill&#10;status → fulfilled&#10;(+ 풀 연결 시 bucket_bids 반영)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1180" y="120" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pg09_a1" style="endArrow=block;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pg09_b1" target="pg09_b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg09_a2" style="endArrow=block;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pg09_b2" target="pg09_b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg09_a3" style="endArrow=block;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pg09_b3" target="pg09_b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg09_a4" style="endArrow=block;html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pg09_b4" target="pg09_b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg09_sc" value="Seaport 컨트랙트 v1.5&#10;0x0000...14dC (constants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;dashed=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="920" y="270" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pg09_note1" value="※ 백엔드는 Seaport 트랜잭션을 대신 실행하지 않습니다. orderHash는 DB 내부 식별용(SHA-256 기반) — docs/DEVELOPMENT.md §3." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#ffffcc;strokeColor=#d6b656;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="1320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="pg04_secD2" value="D2 · 주문 3종 (ask / bid / 풀 연결)" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1720" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg10_pt" value="Seaport 주문 3가지 (모두 DB orders, side·연결만 다름)" style="text;html=1;fontSize=16;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg10_c1" value="매도 리스팅&#10;side = ask&#10;────────────&#10;offer: RWA (ERC-721)&#10;consideration: USDC → 판매자&#10;서명: 판매자 (offerer)&#10;체결: 구매자가 fulfillOrder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pg10_c2" value="일반 매수 입찰&#10;side = bid&#10;────────────&#10;offer: USDC&#10;consideration: RWA → 구매자(offerer)&#10;서명: 구매자&#10;체결: 판매자가 fulfillOrder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="360" y="710" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pg10_c3" value="풀 연결 매수 입찰&#10;side = bid + bucketBidId&#10;────────────&#10;prepare-fulfill 후 동일 Seaport bid 형식&#10;서명: 풀 매수자&#10;DB: orders ↔ bucket_bids&#10;체결 후 풀 fulfilled 처리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="680" y="710" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pg10_com" value="공통: USDC approve(Seaport) + RWA approve(리스팅 시) 등은 각 UI 플로우에서 지갑 트랜잭션" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;fontSize=11;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="940" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg11_qt" value="풀(컬렉션) 입찰 → Seaport 로 이어지는 지점만 도식화" style="text;html=1;fontSize=16;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="560" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg11_q0" value="(범례) 풀 등록은 Seaport 트랜잭션이 아님 — EIP-712 CollectionBid 후 DB" style="text;html=1;fontSize=11;fontStyle=2;align=left;fillColor=#fff9e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1260" width="720" height="24" as="geometry" />
        </mxCell>
        <mxCell id="pg11_q1" value="EIP-712&#10;TokenableCollectionBid&#10;(버킷·USDC·만료)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1330" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg11_q2" value="POST&#10;/bucket-bids&#10;→ DB bucket_bids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="260" y="1330" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg11_q3" value="prepare-fulfill&#10;+ 특정 tokenId&#10;→ Seaport bid 초안" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="460" y="1330" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg11_q4" value="지갑: Seaport&#10;EIP-712 서명&#10;+ POST /orders&#10;side=bid, bucketBidId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="1320" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg11_q5" value="이후&#10;fulfillOrder&#10;→ PATCH fulfill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;" vertex="1" parent="1">
          <mxGeometry x="920" y="1330" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg11_qa1" style="endArrow=block;html=1;" edge="1" parent="1" source="pg11_q1" target="pg11_q2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg11_qa2" style="endArrow=block;html=1;" edge="1" parent="1" source="pg11_q2" target="pg11_q3">
          <mxGeometry relative="1" as="geometry" />
