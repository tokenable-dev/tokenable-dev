        <mxCell id="pg00_ixt" value="Tokenable — diagrams (7탭)" style="text;html=1;fontSize=20;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg00_ixb" value="이 파일 = 7탭으로 정리됨.&#10;&#10;01 — A: 전체구조 · 민팅 · 마켓·Seaport·풀 · 인증/백엔드&#10;02 — B: CeFi·하이브리드 (개요 · 사용자여정 · 비교)&#10;03 — C: PostgreSQL ERD (로컬 DB)&#10;04 — D: Seaport (레이어 · 주문3종 · 풀연결 · 미사용구분)&#10;05 — E: E2E 범례 ~ 리스팅 (E0~E4)&#10;06 — E: E2E 구매 ~ Exchange (E5~E8)&#10;&#10;문서: docs/DEVELOPMENT.md (통합)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=12;fillColor=#fff9e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="720" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg01" name="01-A-아키텍처-A1~A4">
