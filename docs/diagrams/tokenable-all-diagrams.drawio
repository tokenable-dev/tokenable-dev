        <mxCell id="pg01_secA2" value="A2 · RWA 민팅 흐름" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1520" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg02_mt" value="RWA 민팅 흐름 (가스: 사용자 · 수령: 사용자 지갑)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pg02_m2" value="1. 지갑 연결&#10;(wagmi) + Sepolia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg02_m3" value="2. (선택) 슬랩 분석&#10;POST /api/psa/analyze&#10;OCR · PSA · JustTCG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="220" y="770" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg02_m4" value="3. 메타 구성 +&#10;POST /api/rwa/upload&#10;(Pinata → tokenURI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="460" y="770" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg02_m5" value="4. 온체인 mint&#10;writeContract( mint( userAddress, tokenURI ) )&#10;가스: 사용자" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="770" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg02_m6" value="5. 결과&#10;RWA 소유자 = 연결된 지갑&#10;(ERC-721 ownerOf)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="1000" y="770" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg02_ma1" style="endArrow=classic;html=1;" edge="1" parent="1" source="pg02_m2" target="pg02_m3">
          <mxGeometry relative="1" as="geometry" />
