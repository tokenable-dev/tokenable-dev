          <mxGeometry x="20" y="50" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg01_c2b" value="PostgreSQL&#10;orders, bucket_bids,&#10;users, collections..." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;" vertex="1" parent="pg01_c2">
