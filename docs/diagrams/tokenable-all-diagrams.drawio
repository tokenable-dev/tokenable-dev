        </mxCell>
        <mxCell id="pg01_c1" value="사용자 브라우저&#10;Next.js (React) + wagmi / viem" style="swimlane;horizontal=1;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="380" as="geometry" />
        </mxCell>
        <mxCell id="pg01_c1a" value="WalletConnect / MetaMask&#10;· 지갑 연결&#10;· Sepolia 전환&#10;· 서명 · 트랜잭션 (가스 = 사용자)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pg01_c1">
          <mxGeometry x="20" y="50" width="220" height="100" as="geometry" />
