          <mxGeometry x="920" y="80" width="420" height="380" as="geometry" />
        </mxCell>
        <mxCell id="pg01_c3a" value="IPFS (Pinata)&#10;/rwa/upload — 메타·이미지 핀&#10;→ tokenURI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="pg01_c3">
          <mxGeometry x="20" y="50" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg01_c3b" value="Ethereum Sepolia&#10;· Tokenable_RWA (ERC-721) mint&#10;· USDC&#10;· Seaport 1.5 fulfillOrder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;" vertex="1" parent="pg01_c3">
          <mxGeometry x="220" y="50" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pg01_c3c" value="JustTCG / PSA API&#10;(가격·PSA 조회 — 서버 키)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="pg01_c3">
