        <mxCell id="pg01_t1" value="Tokenable — 전체 구조 (사용자 가스 · 지갑 민팅)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
