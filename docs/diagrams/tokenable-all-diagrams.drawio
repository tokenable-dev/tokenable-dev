        <mxCell id="pg11_qa3" style="endArrow=block;html=1;" edge="1" parent="1" source="pg11_q3" target="pg11_q4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg11_qa4" style="endArrow=block;html=1;" edge="1" parent="1" source="pg11_q4" target="pg11_q5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg11_qnote" value="민팅·IPFS·OAuth 는 이 다이어그램 밖(Seaport 미사용)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1450" width="400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg04_secD3" value="D3 · 풀(컬렉션) 입찰 → Seaport 연결" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
