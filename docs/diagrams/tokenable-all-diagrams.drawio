          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg02_m7" value="백엔드: IPFS 업로드·메타만 처리. 민팅 트랜잭션은 보내지 않음." style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#f5f5f5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pg01_secA3" value="A3 · 마켓플레이스 · 오프체인 주문 + Seaport" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="1520" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3Hdr" value="마켓플레이스 — 오프체인 주문 DB + 온체인 Seaport (가스: 트랜잭션 발신자)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3AskBox" value="매도 리스팅 (ask)&#10;① RWA approve(Seaport) — 가스·판매자&#10;② Seaport EIP-712 서명&#10;③ POST /marketplace/orders (side=ask)&#10;→ DB 활성 리스팅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3BidBox" value="매수 입찰 (bid)&#10;① USDC approve — 가스·입찰자&#10;② Seaport 서명&#10;③ POST /marketplace/orders (side=bid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="360" y="1130" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3SettleBox" value="체결&#10;상대방이 Seaport.fulfillOrder&#10;(가스 = 트랜잭션 보낸 쪽)&#10;성공 후 PATCH .../fulfill → DB 반영" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="680" y="1130" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3PoolBox" value="풀 입찰 (컬렉션 단위)&#10;① EIP-712 TokenableCollectionBid&#10;② POST /marketplace/bucket-bids&#10;③ prepare-fulfill + 구매자 Seaport bid&#10;④ bucketBidId 연결 주문 체결 시 풀 fulfilled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="1280" width="920" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3CollPage" value="컬렉션 페이지&#10;GET /collections/:key&#10;→ listings + poolBids + seaportBids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="40" y="1420" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3DocHint" value="상세: docs/DEVELOPMENT.md §3" style="text;html=1;align=left;fontStyle=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="1520" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3EdgeAskToSettle" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="pg03_a3AskBox" target="pg03_a3SettleBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg03_a3EdgeBidToSettle" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="pg03_a3BidBox" target="pg03_a3SettleBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg01_secA4" value="A4 · 인증 · OAuth · 백엔드 RPC" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1630" width="1520" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg04_at" value="인증 · 계정 (온체인과 별도 레이어)" style="text;html=1;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1690" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pg04_a2" value="Google OAuth&#10;→ JWT (httpOnly 쿠키)&#10;GET /auth/me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="40" y="1780" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg04_a3" value="지갑 연동 (프로필)&#10;POST /auth/wallet&#10;DELETE /auth/wallet&#10;→ DB 사용자 ↔ 주소" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="280" y="1780" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg04_a4" value="거래·민팅은 브라우저 지갑 서명으로 수행&#10;(로그인과 독립적일 수 있음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1780" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg04_a5" value="백엔드 읽기 전용 RPC&#10;GET /blockchain/rwa/*&#10;(ownerOf, tokenURI, 잔액 등)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1900" width="300" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pg02" name="02-B-CeFi-하이브리드-B1~B3">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2012" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg05_t1" value="CeFi / 하이브리드 제안 — 내부 원장 중심 + 선택적 온체인 (베스트 프랙티스 스케치)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg05_t2" value="핵심: 사용자는 '계정·잔액·주문'을 플랫폼이 신뢰할 수 있는 원장으로 처리하고, 블록체인은 정산·출금·감사용으로 선택적 사용." style="text;html=1;strokeColor=none;fillColor=#fff9e6;align=left;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="920" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg05_laneUser" value="사용자 계층 (지갑 필수 아님)" style="swimlane;horizontal=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="pg05_u1" value="웹/앱 로그인&#10;OAuth · 이메일 · (선택) 2FA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="pg05_laneUser">
          <mxGeometry x="20" y="45" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg05_u2" value="(선택) KYC 단계&#10;출금·한도·규제 대응" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="pg05_laneUser">
          <mxGeometry x="190" y="45" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg05_u3" value="입금 / 결제&#10;카드·은행·암호화폐 입금&#10;→ 플랫폼 '크레딧' 또는 체인 입금 주소" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="pg05_laneUser">
          <mxGeometry x="350" y="45" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg05_laneCore" value="플랫폼 핵심 (CeFi)" style="swimlane;horizontal=1;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="560" height="320" as="geometry" />
        </mxCell>
        <mxCell id="pg05_c1" value="내부 원장 (SoT)&#10;· 사용자 잔액(법정/스테이블)&#10;· RWA '소유' 레코드 (DB)&#10;· 주문·체결·수수료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="pg05_laneCore">
          <mxGeometry x="20" y="45" width="200" height="110" as="geometry" />
        </mxCell>
