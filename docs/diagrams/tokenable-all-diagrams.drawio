  <diagram id="pg05" name="05-E-E2E-범례~리스팅-E0~E4">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2430" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pg13_e2eHdr" value="Tokenable — 코드 기준 E2E 프로세스 (접속 → 민팅 → 판매)" style="text;html=1;fontSize=20;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg13_sub" value="저장소 기준: frontend (Next.js+wagmi+viem), backend (NestJS), Sepolia, Pinata JWT, JustTCG x-api-key, PSA Public API token(선택)" style="text;html=1;fontSize=11;fillColor=#fff9e6;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg13_tabs" value="통합 파일 탭(7): 00 INDEX | 01 A1~A4 | 02 B1~B3 | 03 ERD | 04 D1~D4 | 05 E0~E4(이 페이지) | 06 E5~E8" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#e6e6e6;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1240" height="44" as="geometry" />
        </mxCell>
        <mxCell id="pg13_entry" value="접속 경로&#10;────────&#10;· / (홈): 탭 Mint | My Assets | Exchange&#10;· /login: Google OAuth → JWT httpOnly 쿠키&#10;· /profile: GET /auth/me, POST /auth/wallet (지갑 연동), 이메일 인증&#10;· Web3: WalletConnect (wagmi) — 민팅/거래와 별도 레이어 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pg13_chain" value="체인·컨트랙트 (constants/contracts.ts)&#10;────────&#10;· Tokenable_RWA: mint, approve, ownerOf (읽기)&#10;· USDC: approve, balanceOf&#10;· Seaport 1.5: getCounter, fulfillOrder&#10;· 네트워크: Ethereum Sepolia (chainId 11155111)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="160" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pg13_api" value="백엔드 API prefix /api&#10;────────&#10;· /psa/analyze — 슬랩 OCR+PSA+JustTCG&#10;· /rwa/upload — Pinata IPFS&#10;· /marketplace/* — 주문·풀&#10;· /blockchain/* — 읽기 전용 RPC&#10;· /price/* — JustTCG 프록시&#10;· /auth/* — OAuth·지갑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pg14_e2eHdr" value="01 — 민팅 탭: PSA 슬랩 분석 (OCR + PSA API + JustTCG)" style="text;html=1;fontSize=17;fontStyle=1;align=left" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="pg14_fe" value="프론트 MintForm.tsx&#10;· analyzePsaSlab() → POST /api/psa/analyze&#10;  multipart: slabFront (필수), slabBack, certNumber(힌트)&#10;· 응답: ocr, psa, psaApi, justtcg, psaCertImages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;spacingLeft=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg14_be" value="백엔드 PsaService.analyzeSlabImages&#10;1) Tesseract.js — 슬랩 이미지 OCR (tesseractRecognize, PSM.SINGLE_BLOCK 등)&#10;2) parsePsaLabelFromOcr / strip — Cert·등급 휴리스틱 (psa-ocr.util)&#10;3) PsaPublicApiService baseUrl https://api.psacard.com/publicapi&#10;   · GET /cert/GetByCertNumber/{cert} — getByCertNumber&#10;   · GET /cert/GetImagesByCertNumber/{cert} — getImagesByCertNumber&#10;   · PSA_PUBLIC_API_TOKEN (Bearer) 있을 때만&#10;4) mergePsaApiIntoParsed — OCR+공식 Cert 병합&#10;5) PriceService.getCards({ q: queryUsed, game: pokemon, limit: 5 })&#10;   → fetch https://api.justtcg.com/v1/cards (x-api-key: TCG_API_KEY)&#10;6) 반환 PsaAnalyzeResult: ocr, psa, psaApi.lookup, justtcg, psaCertImages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;align=left;spacingLeft=8;fontSize=9" vertex="1" parent="1">
          <mxGeometry x="420" y="610" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="pg14_next" value="이후 사용자가 폼 작성 → buildMetadata() gradedMetadata JSON&#10;→ uploadNft(FormData) 단계 (다음 탭 02)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;align=left;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg14_a1" style="endArrow=block;html=1;" edge="1" parent="1" source="pg14_fe" target="pg14_be">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pg15_e2eHdr" value="02 — POST /rwa/upload: Pinata(IPFS) + tokenURI" style="text;html=1;fontSize=17;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pg15_fe" value="프론트: uploadNft(formData)&#10;· name, description, image|imageUrl, gradedMetadata(JSON)&#10;· MintForm: gasWithCap 없음 (서버만)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;spacingLeft=8;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="1240" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg15_be" value="NftService.uploadToIpfs&#10;· PinataService.uploadFile / uploadFromUrl / uploadBuffer&#10;  → PinataSDK (pinataJwt, pinataGateway) public.file&#10;· PSA graded 시: cropPsaSlabForCollectionCover → uploadBuffer (컬렉션 커버 CID)&#10;· 메타: image ipfs://{imageCID}, properties.graded, collectionCoverImage&#10;· pinataService.uploadMetadata(metadata) → metadata CID&#10;· 반환 tokenURI = ipfs://{metadataCID}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;align=left;spacingLeft=8;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="1240" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pg15_env" value="서버 env: PINATA_JWT, PINATA_GATEWAY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="1390" width="280" height="28" as="geometry" />
