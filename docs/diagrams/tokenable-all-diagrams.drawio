        <mxCell id="pg04_secD4" value="D4 · Seaport 범위 밖 (별도 흐름)" style="rounded=0;whiteSpace=wrap;html=1;align=center;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
