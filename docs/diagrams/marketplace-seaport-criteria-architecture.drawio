<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-03-30T12:00:00.000Z" agent="Tokenable" version="24.7.7" type="device" compressed="false">
  <diagram id="page-structure" name="1 — 액터·레이어·저장소">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Marketplace — Seaport ERC721_WITH_CRITERIA + Merkle (현재 제품 구조 요약)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="t1b" value="코드 기준: `frontend/lib/seaport/*`, `CollectionCriteriaBidPanel`, `CollectionUnifiedOrderBook`, `TokenCriteriaMatchPanel`, `submitAskListing.ts` · backend `MarketplaceService` + `marketplace.controller` · DB `orders` (bucket_bid_id 제거, 마이그레이션 `010`)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="lane1" value="① 온체인 (Sepolia)" style="swimlane;horizontal=1;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="600" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Seaport (`SEAPORT_ADDRESS`)&#xa;• `fulfillOrder` — 단일 ask 매수(구매자가 리스팅 이행)&#xa;• `matchAdvancedOrders` — criteria bid(0) + listing(1) 동시 체결&#xa;• AdvancedOrder: `extraData` 비어 있음, `numerator/denominator=1`&#xa;• `recipient` = address(0) — `criteriaMatch.ts` (`MATCH_RECIPIENT_ZERO`)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane1">
          <mxGeometry x="16" y="48" width="560" height="136" as="geometry" />
        </mxCell>

        <mxCell id="lane2" value="② 자산" style="swimlane;horizontal=1;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="110" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Tokenable RWA ERC-721 (`tokenContract`)&#xa;USDC ERC-20 (`considerationToken`)&#xa;Conduit / approve — 리스팅·입찰 전제" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane2">
          <mxGeometry x="16" y="48" width="488" height="72" as="geometry" />
        </mxCell>

        <mxCell id="lane3" value="③ 서버 (NestJS)" style="swimlane;horizontal=1;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="110" width="740" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="`POST /marketplace/orders` — `createOrder` (bid는 itemType 4만)&#xa;`POST .../orders/replace-listing` — `replaceSellerListing` (ask만, 트랜잭션 내 cancel+insert)&#xa;`POST .../orders/fulfill-matched-pair` — `fulfillMatchedPair` (on-chain match 후)&#xa;`PATCH .../orders/:hash/fulfill` — `fulfillOrder` (단일 주문 체결 동기화)&#xa;`GET .../merkle-set/:collectionKey` — 활성 리스팅 tokenId 집합" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane3">
          <mxGeometry x="16" y="48" width="708" height="136" as="geometry" />
        </mxCell>

        <mxCell id="lane4" value="④ PostgreSQL (핵심 열)" style="swimlane;horizontal=1;startSize=32;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1900" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="`orders`&#xa;• `order_hash` (UQ), `side` ask|bid, `offerer`&#xa;• `token_id` — ask: 실제 tokenId / bid(criteria): sentinel `&quot;0&quot;`&#xa;• `collection_key` — ask·bid 모두 컬렉션 논리 키&#xa;• `parameters` jsonb — Seaport OrderParameters 전체 (bid의 `consideration[0].identifierOrCriteria` = Merkle root)&#xa;• `consideration_amount`, `signature`, `status`, `start_time`, `end_time`&#xa;※ 레거시 `bucket_bid_id` 컬럼은 엔티티·마이그레이션 `010`으로 제거" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#f8f4fc;" vertex="1" parent="lane4">
          <mxGeometry x="24" y="48" width="900" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c4b" value="`marketplace_collections` 등 — 컬렉션 메타·키 정규화 (`CollectionService.ensureCollectionForListing` / `findOne`)&#xa;&#xa;Merkle leaf 집합: API가 **활성 ask** tokenId 목록을 내려주고, 클라이언트가 `SeaportMerkleTree`로 root·proof 계산. 입찰 서명 시 root를 `identifierOrCriteria`에 넣음." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane4">
          <mxGeometry x="960" y="48" width="900" height="160" as="geometry" />
        </mxCell>

        <mxCell id="lane5" value="⑤ 프론트 컴포넌트 맵" style="swimlane;horizontal=1;startSize=32;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1900" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="컬렉션 페이지: `CollectionCriteriaBidPanel` (입찰), `CollectionUnifiedOrderBook` (asks + bids, Instant sell)&#xa;토큰 페이지: `TokenCriteriaMatchPanel` + `NftOrderBook` (리스팅·매칭·단일 매수)&#xa;공통: `runCriteriaMatch.ts` (Merkle 검증 → simulate → matchAdvancedOrders → `fulfillMatchedPairApi`)&#xa;`submitAskListing.ts` — create 또는 replace-listing 경로로 ask 저장" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane5">
          <mxGeometry x="24" y="48" width="1850" height="136" as="geometry" />
        </mxCell>

        <mxCell id="lane6" value="⑥ 불변 조건 (요약)" style="swimlane;horizontal=1;startSize=32;fillColor=#fff9e6;strokeColor=#d6b656;fontStyle=1;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="1900" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="• 매수 입찰은 **ERC721_WITH_CRITERIA** + USDC offer만 허용 (`createOrder` 검증).&#xa;• 체결 시 Merkle proof는 **현재 API가 반환하는 leaf 집합**과 동일한 root를 입찰에 기대 (`runCriteriaMatch` root 일치 검사).&#xa;• `matchAdvancedOrders`의 `recipient`는 **항상 0** — 잘못된 판매자 주소로 넣으면 revert.&#xa;• 즉시 매도: ask 가격 &gt; bid 이면 **replace-listing**으로 취소+재등록 후 동일 매칭." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;" vertex="1" parent="lane6">
          <mxGeometry x="24" y="48" width="1850" height="136" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="다음 페이지(탭)에서 시퀀스 상세" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="400" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-flows" name="2 — 시퀀스 상세 (입찰·리스팅·매칭·즉시매도)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ft" value="시퀀스 — 컬렉션 criteria 입찰 / 리스팅 / matchAdvancedOrders / Instant sell" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="32" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="A) 컬렉션 매수 입찰 (buyer)" style="swimlane;horizontal=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1900" height="380" as="geometry" />
        </mxCell>
        <mxCell id="s1a" value="1. `GET /marketplace/.../merkle-set/:collectionKey` — 활성 리스팅에서 나온 `tokenIds[]`&#xa;2. `SeaportMerkleTree(tokenIds)` — `rootHex`, 입찰 시 서명에 사용&#xa;3. USDC `approve` Seaport (또는 Permit 경로)&#xa;4. `getCounter(offerer)` + EIP-712 Seaport 서명 — `consideration[0].itemType=4`, `identifierOrCriteria=root`&#xa;5. `POST /marketplace/orders` — `side=bid`, `tokenId=&quot;0&quot;`, `collectionKey` 필수&#xa;6. 서버 `assertValidCriteriaBid` + `materializeOrderFromDto` — `token_id` 행은 sentinel `0`, `collection_key` 저장&#xa;UI: `CollectionCriteriaBidPanel.tsx`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;" vertex="1" parent="s1">
          <mxGeometry x="24" y="52" width="920" height="300" as="geometry" />
        </mxCell>
        <mxCell id="s1b" value="검증 포인트&#xa;• offer[0] = USDC ERC20&#xa;• consideration[0] = ERC721_WITH_CRITERIA, token = RWA&#xa;• `dto.tokenId === &quot;0&quot;`&#xa;• `collectionKey`로 `marketplace_collections` 존재 확인" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#fff2cc;" vertex="1" parent="s1">
          <mxGeometry x="968" y="52" width="900" height="300" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="B) 매도 리스팅 (seller)" style="swimlane;horizontal=1;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1900" height="280" as="geometry" />
        </mxCell>
        <mxCell id="s2a" value="1. RWA (ERC-721) approve (conduit)&#xa;2. Seaport `signTypedData` — ask, `tokenId` 실제 값&#xa;3. `submitAskListing()` mode `create` → `POST /marketplace/orders` (side=ask)&#xa;4. 서버: 동일 tokenId 활성 ask 중복 거부, `collection_key`는 메타에서 `ensureCollectionForListing`&#xa;파일: `ListRwaModal` / `submitAskListing.ts`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;" vertex="1" parent="s2">
          <mxGeometry x="24" y="52" width="1850" height="200" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="C) 단순 매수 (buyer가 seller 리스팅만 살 때)" style="swimlane;horizontal=1;startSize=36;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1900" height="220" as="geometry" />
        </mxCell>
        <mxCell id="s3a" value="1. USDC approve&#xa;2. `fulfillOrder` (Seaport) — `[tokenId]/page.tsx`&#xa;3. `PATCH .../orders/:listingHash/fulfill` — `fulfillOrder()` 서비스: ask fulfilled, 동일 token 다른 활성 주문 취소 (criteria bid 제외 분기)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;" vertex="1" parent="s3">
          <mxGeometry x="24" y="52" width="1850" height="148" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="D) criteria 매칭 — `runCriteriaMatch` (seller 또는 token owner)" style="swimlane;horizontal=1;startSize=36;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1900" height="520" as="geometry" />
        </mxCell>
        <mxCell id="s4a" value="입력: `bid` (DB Order, criteria), `listing` (ask), `tokenId`, `collectionKey`&#xa;&#xa;1. `getMerkleEligibleTokenIds` — leaf 집합 재조회&#xa;2. `SeaportMerkleTree` — `currentRoot`, `getCriteriaProof(tokenId)`&#xa;3. `bidRoot === currentRoot` 비교 — 불일치 시 사용자 메시지 (입찰 재작성 유도)&#xa;4. `buildCriteriaMatchExecution` — orders=[bidAdv, listingAdv], `criteriaResolvers`에 consideration index 0, `recipient=0`&#xa;5. `matchAdvancedOrdersArgs`로 ABI 인자 패킹&#xa;6. `simulateContract` (matchAdvancedOrders)&#xa;7. `writeContractAsync` + receipt 대기&#xa;8. `fulfillMatchedPairApi({ askOrderHash, bidOrderHash })` — DB에서 ask+bid fulfilled, 동일 token 잔여 ask 취소&#xa;&#xa;파일: `runCriteriaMatch.ts`, `criteriaMatch.ts`, `matchAdvancedOrdersArgs.ts`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;" vertex="1" parent="s4">
          <mxGeometry x="24" y="52" width="1850" height="440" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="E) Instant sell (컬렉션 오더북)" style="swimlane;horizontal=1;startSize=36;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1590" width="1900" height="320" as="geometry" />
        </mxCell>
        <mxCell id="s5a" value="`CollectionUnifiedOrderBook` — `handleInstantSell`&#xa;&#xa;• 선택한 **내 ask**와 **criteria bid** 가격 비교&#xa;• `askPrice &gt; bidPrice` 이면 `submitAskListingOrder({ mode: &quot;replace&quot;, oldOrderHash })` → `POST .../replace-listing` → DB에서 기존 ask cancelled + 동일 token 새 ask 삽입 (Merkle 집합 유지)&#xa;• 이후 `runCriteriaMatch` 동일&#xa;&#xa;목적: 한 UX에서 “고가 ask 취소 → 입찰가로 재등록 → match” 자동화" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;" vertex="1" parent="s5">
          <mxGeometry x="24" y="52" width="1850" height="240" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="F) 오류·운영 메모" style="swimlane;horizontal=1;startSize=36;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1940" width="1900" height="200" as="geometry" />
        </mxCell>
        <mxCell id="s6a" value="• Revert 시 `mapWalletError` / `mapMatchError` — 시뮬레이션으로 원인 좁히기 가능&#xa;• 리스팅 집합·root가 바뀌면 기존 입찰은 **root 불일치** — 취소 후 재입찰&#xa;• `fulfillMatchedPair`는 양쪽 `collection_key` 일치·`bidPrice &gt;= askPrice` 검증" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;" vertex="1" parent="s6">
          <mxGeometry x="24" y="52" width="1850" height="120" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="G) API 엔드포인트 빠른 표" style="swimlane;horizontal=1;startSize=36;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="2180" width="1900" height="220" as="geometry" />
        </mxCell>
        <mxCell id="s7a" value="POST `/marketplace/orders` — `createOrder`&#xa;POST `/marketplace/orders/replace-listing` — `replaceSellerListing` (body: old hash + `CreateOrderDto` ask)&#xa;POST `/marketplace/orders/fulfill-matched-pair` — `{ askOrderHash, bidOrderHash }`&#xa;PATCH `/marketplace/orders/:hash/fulfill` — 단일 `fulfillOrder`&#xa;POST `/marketplace/orders/:hash/cancel` — `cancelOrder`&#xa;GET merkle-set — 컬렉션별 활성 tokenId (클라이언트 Merkle)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;fontFamily=Courier New;" vertex="1" parent="s7">
          <mxGeometry x="24" y="52" width="1850" height="148" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="H) 관련 소스 파일 (탐색용)" style="swimlane;horizontal=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="2440" width="1900" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s8a" value="frontend: `lib/seaport/criteriaMatch.ts`, `runCriteriaMatch.ts`, `submitAskListing.ts`, `merkle.ts`, `matchAdvancedOrdersArgs.ts`, `constants/contracts.ts` (Seaport ABI)&#xa;backend: `marketplace.service.ts`, `marketplace.controller.ts`, `entities/order.entity.ts`&#xa;schema: TypeORM entities + `backend/sql/README.md`" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fontSize=11;fillColor=#ffffff;" vertex="1" parent="s8">
          <mxGeometry x="24" y="52" width="1850" height="108" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
