<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-04-08T00:00:00.000Z" agent="Tokenable" version="24.7.7" type="device" compressed="false">
  <diagram id="full-arch" name="Mint · RWA · Exchange (판매/구매)">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1754" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="hdr-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0a1412;strokeColor=#4a9d82;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="32" width="2400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="hdr-title" value="Tokenable — 민팅 · RWA 메타데이터 · Exchange(Seaport) 판매·구매 구조" style="text;html=1;fontSize=20;fontStyle=1;align=left;fontColor=#94ffd4;" vertex="1" parent="1">
          <mxGeometry x="56" y="40" width="1800" height="32" as="geometry" />
        </mxCell>
        <mxCell id="hdr-sub" value="코드 기준 단일 뷰 · Sepolia · Seaport 1.5 · ERC-721 Tokenable RWA + USDC · 오프체인 주문은 NestJS + PostgreSQL에 동기화 · 병행: 규칙 매칭 테이블(bids/asks/…) — docs/marketplace-trading.md" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#6fd4b8;" vertex="1" parent="1">
          <mxGeometry x="56" y="66" width="2200" height="22" as="geometry" />
        </mxCell>

        <!-- ===== A: MINT & IPFS ===== -->
        <mxCell id="sw-a" value="A — 민팅 파이프라인 (MintForm · IPFS · ERC-721)" style="swimlane;horizontal=1;startSize=36;fillColor=#e8f5f1;strokeColor=#4a9d82;fontStyle=1;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="104" width="2400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="① UI · 기술&#xa;• `MintForm.tsx` (React)&#xa;• 선택: PSA 슬랩 이미지 → `POST /api/psa/analyze` (OCR + Cardhedger + PSA Public API 보강)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="sw-a">
          <mxGeometry x="16" y="52" width="280" height="136" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="② 메타 업로드&#xa;• `uploadRwaMetadata(FormData)` → `POST /api/rwa/upload`&#xa;• `NftService.uploadToIpfs` — 이미지 Pinata 업로드 → `uploadMetadata` JSON&#xa;• 반환: `tokenURI = ipfs://{metadataCID}`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="sw-a">
          <mxGeometry x="320" y="52" width="340" height="136" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="③ 온체인 민트&#xa;• `wagmi` `useWriteContract` + `viem` `publicClient`&#xa;• `gasWithCapFast` (가스 추정·캡)&#xa;• 컨트랙트: `TokenableRWA.mint(to: address, _tokenURI: string)`&#xa;• ABI: `TOKENABLE_RWA_MINT_ABI` (`constants/contracts.ts`)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sw-a">
          <mxGeometry x="684" y="52" width="360" height="136" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="④ 결과&#xa;• 새 `tokenId`, `tokenURI`가 체인에 영구 저장&#xa;• Exchange 컬렉션 키는 그레이드 메타(PSA/Cardhedger)에서 유도 (`CollectionService`)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sw-a">
          <mxGeometry x="1068" y="52" width="320" height="136" as="geometry" />
        </mxCell>
        <mxCell id="e-a12" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4a9d82;" edge="1" parent="sw-a" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a23" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4a9d82;" edge="1" parent="sw-a" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a34" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="sw-a" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== B: EXCHANGE BACKBONE ===== -->
        <mxCell id="sw-b" value="B — Exchange 백본: Seaport 오프체인 orders + 병행 relational 매칭" style="swimlane;horizontal=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="2400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="API (NestJS, 글로벌 프리픽스 `/api`)&#xa;• `MarketplaceController` + `PoketraceProxyController`: orders · collections · `market-snapshots` · poketrace/* 프록시&#xa;• `BidsController` / `TradeController`: `GET /marketplace/bids`, `POST /marketplace/trade/match`(202), `GET …/executions/:id` — docs/marketplace-trading.md · 전체 표 docs/API-REFERENCE.md" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="sw-b">
          <mxGeometry x="16" y="52" width="520" height="156" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="PostgreSQL&#xa;• `orders` — Seaport 서명 주문(핵심 UI 경로)&#xa;• `bids`, `asks`, `match_intents`, `trade_executions`, `idempotency_keys`, `outbox_events` — 규칙 엔진·정산 워커(병행)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#f8f4fc;strokeColor=#9673a6;" vertex="1" parent="sw-b">
          <mxGeometry x="560" y="52" width="540" height="156" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="Seaport (Sepolia `SEAPORT_ADDRESS`)&#xa;• `getCounter(offerer)` — 주문 서명 전 카운터&#xa;• `fulfillOrder(applied, fulfillerConduitKey)` — 단일 ask 매수&#xa;• `matchAdvancedOrders(orders, criteriaResolvers, fulfillments, recipient)`&#xa;  ‣ criteria bid(인덱스 0) + listing(1) + `recipient = address(0)` (`criteriaMatch.ts`)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sw-b">
          <mxGeometry x="1124" y="52" width="520" height="156" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="지갑 · 서명&#xa;• `walletClient.signTypedData` — 도메인 name Seaport / v1.5 / `SEAPORT_ORDER_TYPES`&#xa;• `OrderComponents` — offer[] · consideration[] · salt · conduitKey…&#xa;• 프론트: `viem` + `wagmi` 트랜잭션 브로드캐스트" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="sw-b">
          <mxGeometry x="1668" y="52" width="400" height="156" as="geometry" />
        </mxCell>
        <mxCell id="e-b12" style="endArrow=block;html=1;dashed=1;strokeColor=#9673a6;" edge="1" parent="sw-b" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-bnote" value="동기화" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="sw-b">
          <mxGeometry x="520" y="112" width="56" height="20" as="geometry" />
        </mxCell>

        <!-- ===== C: SELLER ===== -->
        <mxCell id="sw-c" value="C — 판매자 (Seller) 구조" style="swimlane;horizontal=1;startSize=36;fillColor=#fce8e8;strokeColor=#b85450;fontStyle=1;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1160" height="420" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="리스팅 (Ask) 온체인 의도&#xa;• Offer: itemType 2 ERC-721 — `TOKENABLE_RWA` + `tokenId` qty 1&#xa;• Consideration: itemType 1 ERC-20 — `USDC` + 가격(6 dec) → `recipient = seller`&#xa;• `orderType` FULL_OPEN (0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="sw-c">
          <mxGeometry x="16" y="52" width="540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="리스팅 실행 순서 (`ListRwaModal` / `submitAskListing.ts`)&#xa;1. `readContract getCounter`&#xa;2. 필요 시 `ERC721.approve(SEAPORT, tokenId)`&#xa;3. EIP-712 서명 (위 Order 구조)&#xa;4. `createOrder` POST 또는 `replaceListingApi` (리프라이스)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffe6e6;strokeColor=#b85450;" vertex="1" parent="sw-c">
          <mxGeometry x="16" y="168" width="540" height="112" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Instant match (판매자가 컬렉션 비드에 맞춤)&#xa;• UI: `CollectionUnifiedOrderBook` 모달&#xa;• listing 가격 &gt; bid USDC면 `submitAskListingOrder(..., mode:&quot;replace&quot;)` 후&#xa;• `runCriteriaMatch`: Merkle root 일치 검사 → `simulateContract` → `matchAdvancedOrders`&#xa;• `fulfillMatchedPairApi(bidHash, askHash)`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sw-c">
          <mxGeometry x="16" y="292" width="540" height="112" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="모듈 참조&#xa;• `frontend/lib/seaport/criteriaMatch.ts` — `buildCriteriaMatchExecution`, `normalizeSeaportZone`&#xa;• `matchAdvancedOrdersArgs.ts`, `merkle.ts` (`SeaportMerkleTree`)&#xa;• `seaportFulfillOrderArgs.ts` — fulfillOrder 인자 + zone 정규화&#xa;• `normalizeTokenId.ts` — tokenId 문자열 정규화" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;" vertex="1" parent="sw-c">
          <mxGeometry x="584" y="52" width="548" height="352" as="geometry" />
        </mxCell>

        <!-- ===== D: BUYER ===== -->
        <mxCell id="sw-d" value="D — 구매자 (Buyer) 구조" style="swimlane;horizontal=1;startSize=36;fillColor=#e8f5e9;strokeColor=#4a9d82;fontStyle=1;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="560" width="1220" height="420" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="① 단일 리스팅 매수 (토큰 상세 등)&#xa;• 사전: USDC `allowance(buyer, SEAPORT)` &lt; 가격이면 `approve`&#xa;• `fulfillOrder(fulfillSeaportOrderArgs(listing), FULFILL_EXTRA_DATA)`&#xa;• 체결 후 `PATCH fulfill` 또는 `fulfillOrderApi` — DB active → fulfilled&#xa;• 상위 컴포넌트: `page.tsx` token detail, `CollectionCriteriaBidPanel` (북크로스 시)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#ffffff;strokeColor=#4a9d82;" vertex="1" parent="sw-d">
          <mxGeometry x="16" y="52" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="② 컬렉션 criteria 입찰 (한도 주문)&#xa;• `GET /api/marketplace/collections/:key/merkle-set` → `SeaportMerkleTree` → root를 입찰 `identifierOrCriteria`에&#xa;• Offer: USDC (itemType 1) — 최대 지불 의사&#xa;• Consideration: ERC721_WITH_CRITERIA (itemType 4) + Merkle root&#xa;• `POST /api/marketplace/orders` side=bid, tokenId=&quot;0&quot;, collectionKey 필수&#xa;• UI: `CollectionCriteriaBidPanel.tsx`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#e8f5e9;strokeColor=#4a9d82;" vertex="1" parent="sw-d">
          <mxGeometry x="16" y="188" width="580" height="132" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="③ 북 크로스 (입력 가격 ≥ 최저 매도호가)&#xa;• 최저가 리스팅 `pickLowestActiveAsk` 선택&#xa;• 실제 체결·지불액은 리스팅 `considerationAmount` (최저가만)&#xa;• `runInstantPurchase` → 동일 `fulfillOrder` 경로" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="sw-d">
          <mxGeometry x="16" y="336" width="580" height="68" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="정합성·보조&#xa;• 입찰 Merkle root ≡ API가 준 활성 leaf 집합의 root (`runCriteriaMatch`)&#xa;• `bidUsdcAmount` — offer[0] USDC 기준&#xa;• USDC/ETH 가스: `GAS_FALLBACK`, `chainGas.ts`" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;" vertex="1" parent="sw-d">
          <mxGeometry x="616" y="52" width="580" height="352" as="geometry" />
        </mxCell>

        <!-- Arrows A to B conceptual -->
        <mxCell id="e-ab" value="민트된 tokenId / URI → 리스팅 ask의 ERC-721 항목·컬렉션 키로 연결" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4a9d82;dashed=1;fontSize=10;fontColor=#4a9d82;exitX=1;exitY=0.5;entryX=0;entryY=0.35;fontStyle=2;" edge="1" parent="1" source="a4" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== E: LEGEND ===== -->
        <mxCell id="sw-e" value="E — 기술 스택 · 범례" style="swimlane;horizontal=1;startSize=32;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="2400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="클라이언트: Next.js · React · `@tanstack/react-query` · Tailwind (mint `--mint` 팔레트)&#xa;체인: `wagmi` v3 · `viem` · EIP-712 typed data · Sepolia" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;" vertex="1" parent="sw-e">
          <mxGeometry x="12" y="44" width="560" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="스토리지: Pinata IPFS (이미지 + 메타 JSON)&#xa;백엔드: NestJS · TypeORM/SQL — marketplace + nft + psa 모듈" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;" vertex="1" parent="sw-e">
          <mxGeometry x="592" y="44" width="520" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="프로토콜: OpenSea Seaport 1.5 — 주문은 오프체인 서명, 이행은 온체인&#xa;Exchange UI 카피: 앱 내 &quot;Exchange&quot; = 이 Seaport + DB 인덱스 제품면" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;" vertex="1" parent="sw-e">
          <mxGeometry x="1132" y="44" width="620" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="편집: diagrams.net 에서 열기 · 인쇄 시 Page Scale 조절&#xa;관련: `marketplace-seaport-criteria-architecture.drawio` · `marketplace-trading-relational-layer.drawio` · `docs/marketplace-trading.md`" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#eefbf6;fontStyle=2;" vertex="1" parent="sw-e">
          <mxGeometry x="1772" y="44" width="608" height="64" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="Tokenable architecture diagram — single canvas · 2026-03 — repo: docs/diagrams/tokenable-mint-rwa-exchange-full-architecture.drawio" style="text;html=1;fontSize=10;fontStyle=2;align=right;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1140" width="1000" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
