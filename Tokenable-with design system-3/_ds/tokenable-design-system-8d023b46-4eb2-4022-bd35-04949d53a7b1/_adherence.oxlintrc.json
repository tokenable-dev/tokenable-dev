        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='scheme'] > Literal[value!=/^(?:neutral|brand|positive|warning|danger)$/]",
        "message": "<Tag> scheme must be one of 'neutral' | 'brand' | 'positive' | 'warning' | 'danger'."
